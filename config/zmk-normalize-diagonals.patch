+               : 0;
+}
+
+static void normalize_diagonal(struct vector2d *move) {
+    // Keep the resultant speed equal to the faster axis, as for straight motion.
+    if (move->x == 0 || move->y == 0) {
+        return;
+    }
+    float abs_x = move->x < 0 ? -move->x : move->x;
+    float abs_y = move->y < 0 ? -move->y : move->y;
+    float longest_axis = abs_x > abs_y ? abs_x : abs_y;
+    float length_squared = move->x * move->x + move->y * move->y;
+    // Newton's method without libm, which minimal libc builds lack. The
+    // length is within sqrt(2) of the longest axis; five steps reach float
+    // precision.
+    float length = longest_axis;
+    for (int i = 0; i < 5; i++) {
+        length = 0.5f * (length + length_squared / length);
+    }
+    float scale = longest_axis / length;
+    move->x *= scale;
+    move->y *= scale;
