// Pointer settings follow config/glove80.keymap: 200 units/s, 30 notches/s,
// constant velocity, and fast/slow/warp scalers of 9/2, 153/40, and 12/1.
#define ZMK_POINTING_DEFAULT_MOVE_VAL 200
#define ZMK_POINTING_DEFAULT_SCRL_VAL 30

#include <behaviors.dtsi>
#include <input/processors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/kscan_mock.h>
#include <dt-bindings/zmk/pointing.h>

&mmv {
    acceleration-exponent = <0>;
    time-to-max-speed-ms = <0>;
    normalize-diagonals;
};

&msc {
    acceleration-exponent = <0>;
    time-to-max-speed-ms = <0>;
};

&mmv_input_listener {
    slow {
        layers = <1>;
        input-processors = <&zip_xy_scaler 153 40>;
    };
    warp {
        layers = <2>;
        input-processors = <&zip_xy_scaler 12 1>;
    };
    fast {
        layers = <0>;
        input-processors = <&zip_xy_scaler 9 2>;
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &mmv MOVE_UP &mmv MOVE_LEFT &mmv MOVE_DOWN   &mmv MOVE_RIGHT
                &mo 1        &mo 2          &msc SCRL_UP     &msc SCRL_RIGHT
            >;
        };
        slow_layer {
            bindings = <
                &trans &trans &trans &trans
                &trans &trans &trans &trans
            >;
        };
        warp_layer {
            bindings = <
                &trans &trans &trans &trans
                &trans &trans &trans &trans
            >;
        };
    };
};

&kscan {
    rows = <2>;
    columns = <4>;
    events = <
        // Fast: straight, diagonal, opposing keys, then releases.
        ZMK_MOCK_PRESS(0,3,1000)    // right
        ZMK_MOCK_PRESS(0,0,1000)    // up + right
        ZMK_MOCK_PRESS(0,1,1000)    // left cancels right: up
        ZMK_MOCK_RELEASE(0,3,1000)  // up + left
        ZMK_MOCK_RELEASE(0,1,1000)  // up
        ZMK_MOCK_RELEASE(0,0,500)   // stopped
        // Slow layer: straight, then diagonal.
        ZMK_MOCK_PRESS(1,0,10)
        ZMK_MOCK_PRESS(0,3,2000)    // right
        ZMK_MOCK_PRESS(0,2,2000)    // down + right
        ZMK_MOCK_RELEASE(0,3,10)
        ZMK_MOCK_RELEASE(0,2,10)
        ZMK_MOCK_RELEASE(1,0,500)
        // Warp layer: straight, then diagonal.
        ZMK_MOCK_PRESS(1,1,10)
        ZMK_MOCK_PRESS(0,3,1000)    // right
        ZMK_MOCK_PRESS(0,2,1000)    // down + right
        ZMK_MOCK_RELEASE(0,3,10)
        ZMK_MOCK_RELEASE(0,2,10)
        ZMK_MOCK_RELEASE(1,1,500)
        // Scroll is not normalized.
        ZMK_MOCK_PRESS(1,2,1000)    // wheel up
        ZMK_MOCK_PRESS(1,3,1000)    // wheel up + right
        ZMK_MOCK_RELEASE(1,2,10)
        ZMK_MOCK_RELEASE(1,3,500)
    >;
};
